# The commits HomeRow builds on, in one place: build.yml (gnustep-release-
# actions' workflows) loads them. GNUstep itself is the stack gnustep-patches
# publishes, the newest (ghcr.io/ashalkhakov/gnustep:latest). Each must be
# a full commit hash: a branch or a short hash would move under the build.
# Move one in a commit of its own, so that a red run has one cause.

# ashalkhakov/FreeCoreData: Core Data for GNUstep (the framework, momc,
# coredata-model.make). HomeRow dogfoods it, so a FreeCoreData change
# reaches HomeRow when this line moves and not before.
FREECOREDATA_REF=09aecb4e43e2d7eb1b3243b630ca6eeae20a5f20
