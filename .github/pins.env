# What HomeRow builds on, by the exact versions of their releases:
# gnustep-release-actions' workflows (scripts/deps.sh) fetch them from here.
# To move one, edit it here, in a commit of its own, so that a red run has
# one cause.
#   Linux    each one's archive, unpacked into /opt/gnustep, the stack first
#   Windows  each one's archive, unpacked into C:\GNUstep, the stack first
#   Apple    Sparkle's XCFramework, unpacked into .deps/

# The patched GNUstep stack (ashalkhakov/gnustep-patches).
GNUSTEP_PATCHES_VERSION=2026.10.20.16
# Core Data on GNUstep: the framework, momc, coredata-model.make
# (ashalkhakov/FreeCoreData). HomeRow dogfoods it, so a FreeCoreData change
# reaches HomeRow when this line moves and not before.
FREECOREDATA_VERSION=0.9.1
# HomeRow's updates on macOS.
SPARKLE_VERSION=2.10.0
