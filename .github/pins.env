# The commits HomeRow builds on, in one place: ci.yml and release.yml load
# them (gnustep-release-actions/pins), and .github/scripts/dependencies.sh
# reads them. Each must be a full commit hash: a branch or a short hash
# would move under the build. Move one in a commit of its own, so that a
# red run has one cause; moving either rebuilds CI's cached GNUstep stack.

# ashalkhakov/gnustep-patches: the shared GNUstep fixes and its
# build-gnustep.sh (release.yml's stack). At TopoText's commit, where the
# libs-base patches since merged upstream are retired; the one before
# (5b7cea4) no longer applied to libs-base master.
GNUSTEP_PATCHES_REF=dcbad8f6db6db7054bc9152aad3e8686a233809d

# ashalkhakov/FreeCoreData: Core Data for GNUstep (the framework, momc,
# coredata-model.make). HomeRow dogfoods it, so a FreeCoreData change
# reaches HomeRow when this line moves and not before.
FREECOREDATA_REF=09aecb4e43e2d7eb1b3243b630ca6eeae20a5f20
